+def test_live_log_keeps_board_worker_state_through_refresh_and_completion(tmp_path: Path, monkeypatch):
+    """Opening or refreshing the log must not erase the board's live signal."""
+    clock = [1_000.0]
+    monkeypatch.setattr(server.time, "time", lambda: clock[0])
+    db_path = _create_board(tmp_path, heartbeat_at=950)
+
+    def check(status, expected):
+        before = db_path.read_bytes()
+        board_task = server.read_kanban_board("delivery", tmp_path)["columns"][status][0]
+        log_task = server.read_kanban_task_log("delivery", "TASK-1", home=tmp_path, run_id="1")["task"]
+        assert log_task["worker"] == board_task["worker"]
+        assert log_task["worker"]["state"] == expected
+        assert log_task["execution_signal"] == board_task["execution_signal"]
+        assert log_task["worker"]["process_verified"] is None
+        assert db_path.read_bytes() == before
+
+    check("running", "working")
+    clock[0] = 1_200.0
+    check("running", "stale")
+    with sqlite3.connect(db_path) as conn:
+        conn.execute("UPDATE tasks SET status = 'review', current_run_id = NULL, claim_lock = NULL, worker_pid = NULL")
+        conn.execute("UPDATE task_runs SET status = 'done', ended_at = 1190, outcome = 'completed'")
+    check("review", "review")
+
+
