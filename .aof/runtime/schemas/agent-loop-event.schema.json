{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aof.local/schemas/agent-loop-event.schema.json",
  "title": "AOF Agent Loop Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["sequence", "timestamp", "eventType", "traceId", "loopId", "runId", "attemptId", "iteration", "stateVersion", "redactedFields"],
  "properties": {
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "eventType": { "enum": ["observation", "decision", "action-intent", "action-outcome", "verification", "transition", "retry-scheduled", "checkpoint", "cancel-requested", "cancelled", "escalated"] },
    "traceId": { "type": "string", "minLength": 3 },
    "loopId": { "type": "string", "minLength": 3 },
    "runId": { "type": "string", "format": "uuid" },
    "attemptId": { "type": "string", "format": "uuid" },
    "iteration": { "type": "integer", "minimum": 0 },
    "stateVersion": { "type": "integer", "minimum": 0 },
    "observationSequence": { "type": "integer", "minimum": 1 },
    "intentSequence": { "type": "integer", "minimum": 1 },
    "observationRef": { "type": "string", "minLength": 1 },
    "observationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decisionRef": { "type": "string", "minLength": 1 },
    "decisionDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "actionFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "actionDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "argumentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "preconditionDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "idempotencyKeyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityRef", "approvedAt", "expiresAt", "actionDigest", "argumentDigest", "preconditionDigest", "stateVersion"],
      "properties": {
        "authorityRef": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "actionDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "argumentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "preconditionDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "stateVersion": { "type": "integer", "minimum": 0 }
      }
    },
    "resultRef": { "type": "string", "minLength": 1 },
    "resultDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checkerDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "verificationPassed": { "type": "boolean" },
    "postconditionsPassed": { "type": "boolean" },
    "failureClass": { "enum": ["transient", "invalid-input", "precondition-failed", "validation-failed", "policy-blocked", "ambiguous-side-effect", "unsafe-to-retry", "environment-unavailable", "stagnated"] },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "enum": ["running", "success", "blocked", "escalated", "cancelled", "budget-exhausted", "unsafe-to-retry"] },
        "to": { "enum": ["running", "success", "blocked", "escalated", "cancelled", "budget-exhausted", "unsafe-to-retry"] }
      }
    },
    "checkpointDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "retryAfterSeconds": { "type": "integer", "minimum": 0 },
    "reconciled": { "type": "boolean" },
    "childrenPending": { "type": "integer", "minimum": 0 },
    "redactedFields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    { "if": { "properties": { "eventType": { "const": "observation" } } }, "then": { "required": ["observationRef", "observationDigest"] } },
    { "if": { "properties": { "eventType": { "const": "decision" } } }, "then": { "required": ["decisionRef", "decisionDigest"] } },
    { "if": { "properties": { "eventType": { "const": "action-intent" } } }, "then": { "required": ["observationSequence", "actionFingerprint", "actionDigest", "argumentDigest", "preconditionDigest", "idempotencyKeyDigest", "approval"] } },
    { "if": { "properties": { "eventType": { "const": "action-outcome" } } }, "then": { "required": ["intentSequence", "actionFingerprint", "actionDigest", "resultRef", "resultDigest", "reconciled"] } },
    { "if": { "properties": { "eventType": { "const": "verification" } } }, "then": { "required": ["checkerDigest", "verificationPassed", "postconditionsPassed", "resultRef", "resultDigest"] } },
    { "if": { "properties": { "eventType": { "const": "transition" } } }, "then": { "required": ["transition"] } },
    { "if": { "properties": { "eventType": { "const": "retry-scheduled" } } }, "then": { "required": ["failureClass", "retryAfterSeconds"] } },
    { "if": { "properties": { "eventType": { "const": "checkpoint" } } }, "then": { "required": ["checkpointDigest"] } },
    { "if": { "properties": { "eventType": { "const": "cancel-requested" } } }, "then": { "required": ["childrenPending"] } },
    { "if": { "properties": { "eventType": { "const": "cancelled" } } }, "then": { "required": ["childrenPending"] } },
    { "if": { "properties": { "eventType": { "const": "escalated" } } }, "then": { "required": ["failureClass", "resultRef", "resultDigest"] } }
  ]
}
