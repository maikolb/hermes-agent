{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aof.local/schemas/agent-loop-run.schema.json",
  "title": "AOF Agent Loop Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractRef",
    "identity",
    "qualification",
    "trigger",
    "authorities",
    "budgets",
    "checkpoint",
    "concurrency",
    "failurePolicies",
    "verificationPolicy",
    "approvalPolicy",
    "tracePolicy",
    "eventsRef",
    "current"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "scopePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "allowedWritePaths", "deniedWritePaths", "allowDeletions", "manifestDigest"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "allowedWritePaths": { "$ref": "#/definitions/nonEmptyStringArray" },
        "deniedWritePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowDeletions": { "type": "boolean" },
        "manifestDigest": { "$ref": "#/definitions/sha256" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loopId", "runId", "attemptId", "traceId"],
      "properties": {
        "loopId": { "$ref": "#/definitions/stableId" },
        "runId": { "$ref": "#/definitions/uuid" },
        "parentRunId": { "$ref": "#/definitions/uuid" },
        "attemptId": { "$ref": "#/definitions/uuid" },
        "traceId": { "$ref": "#/definitions/stableId" }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasons"],
      "properties": {
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["long-running", "scheduled", "event-driven", "resumable", "concurrent", "high-cost", "external-side-effect", "high-risk"]
          }
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "provenance", "deduplicationKey", "deduplicationWindowSeconds", "overlapPolicy"],
      "properties": {
        "type": { "enum": ["manual", "scheduled", "event", "resume"] },
        "provenance": { "type": "string", "minLength": 1 },
        "deduplicationKey": { "type": "string", "minLength": 1 },
        "deduplicationWindowSeconds": { "type": "integer", "minimum": 0 },
        "overlapPolicy": { "enum": ["reject", "queue", "coalesce", "cancel-previous", "parallel-isolated"] }
      }
    },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateSourceIds", "gateRefs", "approvalAuthorityRefs"],
      "properties": {
        "stateSourceIds": { "$ref": "#/definitions/nonEmptyStringArray" },
        "gateRefs": { "$ref": "#/definitions/nonEmptyStringArray" },
        "approvalAuthorityRefs": { "$ref": "#/definitions/nonEmptyStringArray" }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxIterations", "maxWallClockSeconds", "maxToolCalls", "maxRetries", "maxStagnantIterations", "maxOutputBytes", "maxConcurrency", "sideEffectCeiling"],
      "properties": {
        "maxIterations": { "type": "integer", "minimum": 1 },
        "maxWallClockSeconds": { "type": "integer", "minimum": 1 },
        "maxToolCalls": { "type": "integer", "minimum": 1 },
        "maxRetries": { "type": "integer", "minimum": 0 },
        "maxStagnantIterations": { "type": "integer", "minimum": 1 },
        "maxOutputBytes": { "type": "integer", "minimum": 1 },
        "maxConcurrency": { "type": "integer", "minimum": 1 },
        "sideEffectCeiling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "maxConsequentialActions"],
          "properties": {
            "enabled": { "type": "boolean" },
            "maxConsequentialActions": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateSchemaRef", "stateSchemaVersion", "expectedStateVersion", "iteration", "atomicWritePolicy", "lastEventSequence", "lastKnownGoodRef", "priorCheckpointRef", "resumePolicy", "replayPolicy", "digest"],
      "properties": {
        "stateSchemaRef": { "type": "string", "minLength": 1 },
        "stateSchemaVersion": { "type": "string", "minLength": 1 },
        "expectedStateVersion": { "type": "integer", "minimum": 0 },
        "iteration": { "type": "integer", "minimum": 0 },
        "atomicWritePolicy": { "enum": ["atomic-replace", "transactional", "compare-and-swap"] },
        "lastEventSequence": { "type": "integer", "minimum": 0 },
        "lastKnownGoodRef": { "type": "string", "minLength": 1 },
        "priorCheckpointRef": { "type": "string", "minLength": 1 },
        "resumePolicy": { "enum": ["never", "from-checkpoint", "reconcile-then-resume"] },
        "replayPolicy": { "enum": ["no-side-effect-replay", "idempotent-only", "reconcile-before-replay"] }
        ,"digest": { "$ref": "#/definitions/sha256" }
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "casEnabled", "partitions"],
      "properties": {
        "mode": { "enum": ["single-writer", "compare-and-swap", "declared-reducer", "lock", "partitioned-isolation"] },
        "casEnabled": { "type": "boolean" },
        "reducerRef": { "type": "string" },
        "lockRef": { "type": "string" },
        "partitions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "failurePolicies": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "retryable", "limit", "backoff", "requireReobservation", "safetyMechanism", "escalationRef"],
        "properties": {
          "class": { "$ref": "#/definitions/failureClass" },
          "retryable": { "type": "boolean" },
          "limit": { "type": "integer", "minimum": 0 },
          "backoff": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "baseSeconds", "maxSeconds"],
            "properties": {
              "type": { "enum": ["none", "fixed", "exponential"] },
              "baseSeconds": { "type": "integer", "minimum": 0 },
              "maxSeconds": { "type": "integer", "minimum": 0 }
            }
          },
          "requireReobservation": { "type": "boolean" },
          "safetyMechanism": { "enum": ["no-retry", "idempotency-key", "reconciliation", "compensation"] },
          "escalationRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verificationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracleRef", "executorIdentity", "checkerRef", "checkerIdentity", "checkerIndependent", "checkerDigest", "immutableFixtureRefs", "immutableFixtureDigests", "feedbackRef", "requiredAttemptDelta", "highRisk"],
      "properties": {
        "oracleRef": { "type": "string", "minLength": 1 },
        "executorIdentity": { "type": "string", "minLength": 1 },
        "checkerRef": { "type": "string", "minLength": 1 },
        "checkerIdentity": { "type": "string", "minLength": 1 },
        "checkerIndependent": { "type": "boolean" },
        "checkerDigest": { "$ref": "#/definitions/sha256" },
        "checkerCommand": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argv", "argvDigest", "executableSha256"],
          "properties": {
            "argv": { "$ref": "#/definitions/nonEmptyStringArray" },
            "argvDigest": { "$ref": "#/definitions/sha256" },
            "executableSha256": { "$ref": "#/definitions/sha256" }
          }
        },
        "immutableFixtureRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "immutableFixtureDigests": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/sha256" } },
        "feedbackRef": { "type": "string", "minLength": 1 },
        "requiredAttemptDelta": { "type": "string", "minLength": 1 },
        "highRisk": { "type": "boolean" }
      }
    },
    "approvalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredForConsequentialActions", "authorityRefs", "bindingFields", "maxAgeSeconds", "reapprovalOnStateChange"],
      "properties": {
        "requiredForConsequentialActions": { "type": "boolean" },
        "authorityRefs": { "$ref": "#/definitions/nonEmptyStringArray" },
        "bindingFields": { "$ref": "#/definitions/nonEmptyStringArray" },
        "maxAgeSeconds": { "type": "integer", "minimum": 1 },
        "reapprovalOnStateChange": { "type": "boolean" }
      }
    },
    "tracePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedEventFields", "redactedFields", "prohibitedContent", "retentionDays", "accessPolicyRef"],
      "properties": {
        "allowedEventFields": { "$ref": "#/definitions/nonEmptyStringArray" },
        "redactedFields": { "$ref": "#/definitions/nonEmptyStringArray" },
        "prohibitedContent": { "$ref": "#/definitions/nonEmptyStringArray" },
        "retentionDays": { "type": "integer", "minimum": 1 },
        "accessPolicyRef": { "type": "string", "minLength": 1 }
      }
    },
    "eventsRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schemaRef"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "schemaRef": { "type": "string", "minLength": 1 }
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "iteration", "stagnantIterations", "retryCount", "toolCallCount", "outputBytes", "startedAt", "observation", "decision", "action", "verification", "transition", "cancellation", "ambiguityResolved", "budgetExhausted"],
      "properties": {
        "status": { "$ref": "#/definitions/status" },
        "iteration": { "type": "integer", "minimum": 0 },
        "stagnantIterations": { "type": "integer", "minimum": 0 },
        "retryCount": { "type": "integer", "minimum": 0 },
        "toolCallCount": { "type": "integer", "minimum": 0 },
        "outputBytes": { "type": "integer", "minimum": 0 },
        "startedAt": { "type": "string", "format": "date-time" },
        "observation": { "$ref": "#/definitions/observation" },
        "decision": { "$ref": "#/definitions/referenceDigest" },
        "action": { "$ref": "#/definitions/action" },
        "verification": { "$ref": "#/definitions/verification" },
        "transition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "$ref": "#/definitions/status" },
            "to": { "$ref": "#/definitions/status" }
          }
        },
        "cancellation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "propagateToChildren", "childrenPending"],
          "properties": {
            "requested": { "type": "boolean" },
            "requestedAt": { "type": "string", "format": "date-time" },
            "propagateToChildren": { "type": "boolean" },
            "childrenPending": { "type": "integer", "minimum": 0 }
          }
        },
        "ambiguityResolved": { "type": "boolean" },
        "budgetExhausted": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "uuid": { "type": "string", "format": "uuid" },
    "stableId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "nonEmptyStringArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "failureClass": { "enum": ["transient", "invalid-input", "precondition-failed", "validation-failed", "policy-blocked", "ambiguous-side-effect", "unsafe-to-retry", "environment-unavailable", "stagnated"] },
    "status": { "enum": ["running", "success", "blocked", "escalated", "cancelled", "budget-exhausted", "unsafe-to-retry"] },
    "referenceDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/definitions/sha256" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "observedAt", "freshnessCeilingSeconds", "stateVersion"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/definitions/sha256" },
        "observedAt": { "type": "string", "format": "date-time" },
        "freshnessCeilingSeconds": { "type": "integer", "minimum": 1 },
        "stateVersion": { "type": "integer", "minimum": 0 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capabilityClass", "consequential", "fingerprint", "actionDigest", "argumentDigest", "preconditions", "postconditions", "noRetry"],
      "properties": {
        "id": { "$ref": "#/definitions/stableId" },
        "capabilityClass": { "enum": ["read-only", "workspace-write", "external-side-effect", "destructive"] },
        "consequential": { "type": "boolean" },
        "fingerprint": { "$ref": "#/definitions/sha256" },
        "actionDigest": { "$ref": "#/definitions/sha256" },
        "argumentDigest": { "$ref": "#/definitions/sha256" },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "reconciliationRef": { "type": "string", "minLength": 1 },
        "preconditions": { "$ref": "#/definitions/nonEmptyStringArray" },
        "postconditions": { "$ref": "#/definitions/nonEmptyStringArray" },
        "intentSequence": { "type": "integer", "minimum": 1 },
        "outcomeSequence": { "type": "integer", "minimum": 1 },
        "noRetry": { "type": "boolean" },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authorityRef", "approvedAt", "expiresAt", "actionDigest", "argumentDigest", "preconditionDigest", "stateVersion"],
          "properties": {
            "authorityRef": { "type": "string", "minLength": 1 },
            "approvedAt": { "type": "string", "format": "date-time" },
            "expiresAt": { "type": "string", "format": "date-time" },
            "actionDigest": { "$ref": "#/definitions/sha256" },
            "argumentDigest": { "$ref": "#/definitions/sha256" },
            "preconditionDigest": { "$ref": "#/definitions/sha256" },
            "stateVersion": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceRef", "passed", "postconditionsPassed", "checkerDigest"],
      "properties": {
        "evidenceRef": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "postconditionsPassed": { "type": "boolean" },
        "checkerDigest": { "$ref": "#/definitions/sha256" }
      }
    }
  }
}
